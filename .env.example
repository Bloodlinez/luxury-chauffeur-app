PORT=3001
VITE_API_URL=http://localhost:3001
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-secure-secret
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aurelia
DATABASE_SSL=false
STRIPE_SECRET_KEY=sk_test_replace-with-test-key
STRIPE_WEBHOOK_SECRET=replace-with-webhook-secret
RESEND_API_KEY=replace-with-resend-key
TWILIO_SID=replace-with-twilio-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-token
# Server-only Mapbox secret token for /api/address-suggest (never expose to Vite/client).
# Create a token at https://account.mapbox.com/access-tokens/ with temporary geocoding allowed.
# Monitor usage under Mapbox Account → Statistics. Do not commit a real token.
MAPBOX_TOKEN=replace-with-mapbox-token
FLIGHT_API_KEY=replace-with-flight-api-key
